# ==============================================================================
# Personal AI Assistant — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_ai

# Cache & Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider Gateway Configuration
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=llama3.2
DISABLE_CLOUD_MODELS=false

# Local Ollama Inference
OLLAMA_BASE_URL=http://localhost:11434

# Free-Tier Cloud Model APIs (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_NAME=open-mistral-7b
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# OpenAI Adapter (Slot disabled initially for ₹0 budget)
OPENAI_API_KEY=disabled

# Next.js Web Application
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth 2.0 & Gmail Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:3000
